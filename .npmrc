save-exact=true
engine-strict=true
fund=false

# Chaîne d'approvisionnement (voir docs/DECISIONS.md §13) :
# - aucun script d'installation n'est exécuté (les binaires natifs arrivent par optionalDependencies) ;
# - une nouvelle version n'est installée qu'après 7 jours de publication (npm >= 11.10 ; `npm ci`
#   suit le lockfile et n'est pas affecté).
ignore-scripts=true
min-release-age=7
