{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "useDefineForClassFields": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true,
    // Autorise `./chemin/fichier.ts` à l'import. Utilisé par le seul `vite.config.ts`, dont le
    // chargeur natif — futur défaut de Vite — exige l'extension. Rien d'autre n'en a besoin :
    // le reste du code garde ses imports sans extension.
    "allowImportingTsExtensions": true,
    // Chemins relatifs au tsconfig, SANS `baseUrl` : TypeScript 6 le déprécie et TypeScript 7
    // cessera de l'honorer. La forme `./src/lib` fait exactement la même chose sans l'ancrage.
    "paths": {
      "$lib": ["./src/lib"],
      "$lib/*": ["./src/lib/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.svelte",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "vite.config.ts",
    "playwright.config.ts",
    "playwright.monitor.config.ts",
    "svelte.config.js",
    "eslint.config.js",
    "mcp/**/*.ts",
    "vite.mcp.config.ts"
  ],
  "exclude": ["node_modules", "dist", "dev-dist", "coverage"]
}
