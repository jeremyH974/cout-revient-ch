# Dépendances et sorties de build
node_modules/
dist/
dev-dist/
coverage/
reports/
# Le bac à sable de Stryker : effacé après un relevé réussi, LAISSÉ après un échec — et il porte
# une jonction `node_modules` vers le dépôt. Retirer la jonction seule avant d'effacer le reste.
.stryker-tmp/
.vite/
*.log
.env
.env.*

# Tests de bout en bout (Playwright) et Lighthouse CI
playwright-report/
test-results/
blob-report/
.lighthouseci/
monitor-results/

# Système
.DS_Store
Thumbs.db

# Relevés de courtier personnels : JAMAIS dans git (seules les fixtures synthétiques sont
# autorisées). Le classeur compte autant que le CSV — c'est le format du relevé eToro.
*.csv
!tests/fixtures/**/*.csv
*.xlsx
*.xls
*.xlsm
!tests/fixtures/**/*.xlsx
/data/

# La sauvegarde JSON de l'application : elle porte TOUT l'état — lignes brutes, saisies,
# qualifications, comptes, réglages, cache de prix. Ni `*.csv` ni le classeur ne la couvraient, et
# le dépôt suit ses `*.json` : déposée à la racine, elle n'était arrêtée par rien. Chiffrée, elle
# n'a pas davantage sa place ici. La fixture gelée (`tests/fixtures/storage/backup-v1.json`) porte
# un autre nom, et reste donc suivie.
*cout-revient-ch-sauvegarde*.json

# Grille tarifaire Coinhouse (PDF tiers, non redistribuable) : ses taux sont repris, sourcés et
# datés dans src/lib/domain/fees.ts — le document lui-même reste hors du dépôt public.
docs/CH_-GrilleTarifaire*.pdf

# Claude Code (réglages locaux)
.claude/settings.local.json
# Worktrees Claude : un dépôt complet avec son `node_modules` vit ici. Ils n'étaient protégés que
# par leur propre fichier `.git` et par `.git/info/exclude`, qui est local et ne se partage pas.
.claude/worktrees/
mcp/dist/
