# Relevés de courtier personnels : JAMAIS dans git (seules les fixtures synthétiques sont
# autorisées). Le classeur compte autant que le CSV — c'est le format du relevé eToro.
*.csv
!tests/fixtures/**/*.csv
*.xlsx
*.xls
*.xlsm
!tests/fixtures/**/*.xlsx
/data/

# Grille tarifaire Coinhouse (PDF tiers, non redistribuable) : ses taux sont repris, sourcés et
# datés dans src/lib/domain/fees.ts — le document lui-même reste hors du dépôt public.
docs/CH_-GrilleTarifaire*.pdf

# Claude Code (réglages locaux)
.claude/settings.local.json
# Worktrees Claude : un dépôt complet avec son `node_modules` vit ici. Ils n'étaient protégés que
# par leur propre fichier `.git` et par `.git/info/exclude`, qui est local et ne se partage pas.
.claude/worktrees/
mcp/dist/
