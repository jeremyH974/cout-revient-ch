{
  "name": "cout-revient-ch",
  "version": "2.4.0",
  "private": true,
  "type": "module",
  "description": "PRU et plus/moins-values par crypto à partir de l'export Coinhouse — 100 % dans votre navigateur",
  "license": "MIT",
  "author": "jeremyH974",
  "repository": {
    "type": "git",
    "url": "https://github.com/jeremyH974/cout-revient-ch.git"
  },
  "homepage": "https://jeremyh974.github.io/cout-revient-ch/",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . && prettier --check . && node scripts/check-no-personal-csv.js",
    "format": "prettier --write .",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "check": "npm run lint && npm run typecheck && npm run test",
    "e2e": "vite build && playwright test",
    "e2e:ui": "playwright test --ui",
    "lhci": "vite build && lhci autorun",
    "monitor": "playwright test --config playwright.monitor.config.ts && node scripts/api-contract.mjs",
    "fixture": "node scripts/generate-fixture.ts",
    "fixture:hl": "node scripts/generate-hl-fixture.ts"
  },
  "dependencies": {
    "@noble/hashes": "2.3.0",
    "@scure/base": "2.3.0",
    "@scure/bip32": "2.3.0",
    "big.js": "7.0.1",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.8",
    "papaparse": "5.6.0",
    "svelte": "5.56.10",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.62.1",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/big.js": "7.0.0",
    "@types/node": "26.2.0",
    "@types/papaparse": "5.5.2",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.23.0",
    "fake-indexeddb": "6.2.5",
    "fast-check": "4.9.0",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.11",
    "workbox-build": "7.4.1"
  }
}
